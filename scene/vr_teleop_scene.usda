    def Xform "Robot" (
        prepend references = @https://omniverse-content-production.s3-us-west-2.amazonaws.com/Assets/Isaac/6.0/Isaac/Robots/Fanuc/crx10ia_l/crx10ia_l.usd@
    )
    {
        quatd xformOp:orient = (1, 0, 0, 0)
        double3 xformOp:scale = (1, 1, 1)
        double3 xformOp:translate = (0, 0, 0.8500053286552429)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

        over "root_joint"
        {
            int physxArticulation:solverPositionIterationCount = 12
        }

        over "joints"
        {
            def PhysicsFixedJoint "gripper_mount"
            {
                rel physics:body0 = </World/Robot/J6_link>
                rel physics:body1 = </World/Gripper/Robotiq_2F_85/base_link>
                uniform bool physics:excludeFromArticulation = 0
                point3f physics:localPos0 = (0.16, 0, 0)
                point3f physics:localPos1 = (0, 0, 0)
                quatf physics:localRot0 = (0.70710677, 0, 0.70710677, 0)
                quatf physics:localRot1 = (1, 0, 0, 0)
            }
        }

        over "J6_link"
        {
            over "flange"
            {
                over "ee_link"
                {
                    def Camera "WristCamera"
                    {
                        float2 clippingRange = (0.01, 50)
                        float focalLength = 12
                        float horizontalAperture = 20.955
                        float verticalAperture = 11.787188
                        matrix4d xformOp:transform = ( (0, -1, 0, 0), (0.3226739277881386, 0, 0.9465101881785398, 0), (-0.9465101881785398, 0, 0.3226739277881386, 0), (0.02, -0, 0.075, 1) )
                        uniform token[] xformOpOrder = ["xformOp:transform"]
                    }
                }
            }
        }
    }

