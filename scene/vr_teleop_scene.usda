        }

        def Material "DR_Table"
        {
            token outputs:mdl:displacement.connect = </World/Looks/DR_Table/Shader.outputs:out>
            token outputs:mdl:surface.connect = </World/Looks/DR_Table/Shader.outputs:out>
            token outputs:mdl:volume.connect = </World/Looks/DR_Table/Shader.outputs:out>

            def Shader "Shader"
            {
                uniform token info:id = "OmniPBR"
                uniform token info:implementationSource = "sourceAsset"
                uniform asset info:mdl:sourceAsset = @OmniPBR.mdl@
                uniform token info:mdl:sourceAsset:subIdentifier = "OmniPBR"
                color3f inputs:diffuse_color_constant = (0.6, 0.6, 0.6)
                float inputs:metallic_constant = 0.5
                float inputs:reflection_roughness_constant = 0.4
