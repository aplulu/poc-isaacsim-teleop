        variants = {
            string Physics = "Physx_Mimic"
        }
    )
    {
        quatd xformOp:orient = (0.7071067811865476, 0, 0.7071067811865476, 0)
        double3 xformOp:translate = (0.7000000178813934, -0.15000000596046448, 1.8050053119659424)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]

        over "Robotiq_2F_85" (
            delete apiSchemas = ["PhysicsArticulationRootAPI", "PhysxArticulationAPI"]
        )
        {
            over "Joints"
            {
                over "finger_joint"
                {
                    float drive:angular:physics:damping = 2
                    float drive:angular:physics:maxForce = 60
                    float drive:angular:physics:stiffness = 40
                }
